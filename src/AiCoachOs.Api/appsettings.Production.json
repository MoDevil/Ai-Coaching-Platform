{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=aicoachos_prod;Username=postgres;Password=YOUR_PROD_PASSWORD;"
  },
  "Jwt": {
    "Issuer": "AiCoachOs",
    "Audience": "AiCoachOsApp",
    "SecretKey": "CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION",
    "ExpirationMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.aicoachos.com"
    ]
  },
  "AiSettings": {
    "Provider": "Anthropic",
    "Model": "claude-sonnet-4-6",
    "Temperature": 0.2,
    "MaxTokens": 2048,
    "TimeoutSeconds": 30
  }
}
