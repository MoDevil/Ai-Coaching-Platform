{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=aicoachos;Username=postgres;Password=;"
  },
  "Jwt": {
    "Issuer": "AiCoachOs",
    "Audience": "AiCoachOsApp",
    "SecretKey": "",
    "ExpirationMinutes": 120
  },
  "AiSettings": {
    "Provider": "Mock",
    "AnthropicApiKey": "",
    "Model": "claude-sonnet-4-6",
    "Temperature": 0.2,
    "MaxTokens": 2048,
    "TimeoutSeconds": 30
  },
  "AiProviders": {
    "//": "The router walks this list in ascending Priority order and moves to the next provider whenever the current one fails or exhausts its keys. Each ApiKeysEnvVar holds a comma-separated list of keys that are rotated through in turn.",
    "Providers": [
      {
        "Name": "Anthropic",
        "Priority": 1,
        "ApiKeysEnvVar": "ANTHROPIC_API_KEYS",
        "Model": "claude-sonnet-4-6",
        "Enabled": true
      },
      {
        "Name": "Gemini",
        "Priority": 2,
        "ApiKeysEnvVar": "GEMINI_API_KEYS",
        "Model": "gemini-2.0-flash",
        "Enabled": true
      },
      {
        "Name": "xAI",
        "Priority": 3,
        "ApiKeysEnvVar": "XAI_API_KEYS",
        "Model": "grok-4.6",
        "Enabled": true
      },
      {
        "Name": "Groq",
        "Priority": 4,
        "ApiKeysEnvVar": "GROQ_API_KEYS",
        "Model": "llama-3.3-70b-versatile",
        "Enabled": true
      },
      {
        "Name": "Cerebras",
        "Priority": 5,
        "ApiKeysEnvVar": "CEREBRAS_API_KEYS",
        "Model": "qwen-3.8-27b",
        "Enabled": true
      },
      {
        "Name": "SambaNova",
        "Priority": 6,
        "ApiKeysEnvVar": "SAMBANOVA_API_KEYS",
        "Model": "gpt-oss-120b",
        "Enabled": true
      },
      {
        "Name": "HuggingFace",
        "Priority": 7,
        "ApiKeysEnvVar": "HUGGINGFACE_API_KEYS",
        "Model": "openai/gpt-oss-120b",
        "Enabled": true
      },
      {
        "Name": "OpenRouter",
        "Priority": 8,
        "ApiKeysEnvVar": "OPENROUTER_API_KEYS",
        "Model": "openai/gpt-4o-mini",
        "Enabled": true
      }
    ]
  }
}
